{
  // The EXISTING Worker that serves neyzam.online (seen in Cloudflare DNS as "Worker: neyzam-site").
  // Static site from ./public, plus the booking API. Only /api/* runs the script; everything else is served
  // straight from the assets, exactly as before.
  "name": "neyzam-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "neyzam-bookings", "database_id": "e03cf158-e01b-4280-99a5-fb7c7264d344", "migrations_dir": "migrations" }
  ]
}
